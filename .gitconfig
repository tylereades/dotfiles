# Identity is machine-specific and deliberately NOT tracked.
# On a new machine: cp .gitconfig-identity.example ~/.gitconfig-identity
# and fill in the right name/email for that machine.
[include]
	path = ~/.gitconfig-identity

[init]
	defaultBranch = main

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
